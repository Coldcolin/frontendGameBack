# Copy to .env — leave MONGODB_URI empty to use a throwaway in-memory MongoDB (dev only;
# production refuses to start without it)
MONGODB_URI=
PORT=4000
# One or more frontend origins, comma-separated
WEB_ORIGIN=http://localhost:3000
# Optional regex for extra origins, e.g. Vercel previews: ^https://diffarena-[a-z0-9-]+\.vercel\.app$
WEB_ORIGIN_PATTERN=
# Concurrent Chromium pages used for grading (1 on a 512 MB instance)
MAX_RENDER_PAGES=2
# Proxy hops in front of the backend (1 on Render) so rate limits see client IPs
TRUST_PROXY=0
# Per-IP limits per 15 minutes
RATE_LIMIT_MATCHES=30
RATE_LIMIT_UPLOADS=30
RATE_LIMIT_API=1500
